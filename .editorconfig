root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_style = space
indent_size = 2

[*.{c,h}]
indent_style = space
indent_size = 4

[*.{cpp,hpp}]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.lua]
indent_style = space
indent_size = 4

[*.css]
indent_style = space
indent_size = 2

[*.html]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4

[*.hs]
indent_style = space
indent_size = 2

[*.tf]
indent_style = space
indent_size = 2

[*.txt]
indent_style = space
indent_size = 4
